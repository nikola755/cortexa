{   
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": "~/.config/fastfetch/logo",
    "display": {
        "separator": " ›  "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "OS  ",
            "format": "arch linux",
        },
        {
            "type": "command",
            "key": "KER ",
            "shell": "/bin/sh",
            "text": "sh -c \"echo -n 'linux-zen '; uname -r | cut -d'-' -f1\"",
        },
        {
            "type": "packages",
            "key": "PKG ", 
            "format": "{all}",
        },
        {
            "type": "shell",
            "key": "SH  ",
            "format": "fish",
        },
        {
            "type": "terminal",
            "key": "TER ",
            "format": "kitty",
        },
        {
            "type": "wm",
            "key": "WM  ",
            "format": "hyprland",
        },
        "break",
    ]
}
