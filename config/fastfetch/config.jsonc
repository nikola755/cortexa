{   
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": "~/.config/fastfetch/logo",
    "display": {
      // "separator": " ›  "
      "separator": " "
    },
    "modules": [
	"break",
        {
            "type": "os",
            "key": "os  ",
            "format": "arch linux",
        },
        {
            "type": "command",
            "key": "ker ",
            "shell": "/bin/sh",
            "text": "sh -c \"echo -n 'linux-zen '; uname -r | cut -d'-' -f1\"",
        },
        {
            "type": "wm",
            "key": "wm  ",
            "format": "hyprland",
        },
        {
            "type": "shell",
            "key": "sh  ",
            "format": "fish",
        },
        {
            "type": "terminal",
            "key": "ter ",
            "format": "kitty",
        },
        {
            "type": "command",
            "key": "mem ",
            "text": "free -m | awk 'NR==2{printf \"%dm .. %dm\",$3,$2}'",
            "format": ""
        },
        "break",
    ]
}
